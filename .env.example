# Client-safe feature modes only. Never put secret keys in VITE_* variables.
VITE_AI_MODE=demo
VITE_QUOTE_MODE=local
VITE_SITE_URL=
VITE_WHATSAPP_NUMBER=

# Server-side only (Vercel Functions / Cloudflare Pages Functions).
# Use AI_PROVIDER=cloudflare-flux to call Workers AI with FLUX.2 Klein 9B.
# Keep both Cloudflare values as server secrets; never prefix them with VITE_.
AI_PROVIDER=demo
AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
QUOTE_STORAGE_PROVIDER=demo
QUOTE_STORAGE_URL=
QUOTE_STORAGE_KEY=
