# Client-safe feature modes only. Never put secret keys in VITE_* variables.
# The browser calls the same-origin /api/ai/... routes by default, where the provider keys live, so
# no build flag is needed to generate real concepts. Set VITE_AI_MODE=demo only for an offline
# demonstration: the browser then never calls the AI service and no render can be created.
VITE_AI_MODE=api
VITE_QUOTE_MODE=local
VITE_SITE_URL=
VITE_WHATSAPP_NUMBER=

# --- Multi-provider AI (server-side only; Vercel Functions / Cloudflare Pages Functions) -------
# SignCraft AI tries the remaining providers when one is rate-limited, out of quota, temporarily
# unavailable, or misconfigured, and only stops when a provider answers with an image.
#
# A provider joins the chain as soon as its API key is present. You do not need all of them.
# Leaving this empty uses the default order below, which ends with the Cloudflare provider this app
# shipped with, so an existing Cloudflare-only deployment keeps working untouched.
# Pollinations is opt-in: add it to this list to include it (its position in the list is the order
# it is tried in), for example: pollinations,groq,gemini,openrouter
AI_PROVIDER_ORDER=groq,gemini,openrouter,cloudflare-flux
#
# Optional tuning. AI_PROVIDER_TIMEOUT_MS is one provider attempt, AI_TOTAL_TIMEOUT_MS is the whole
# chain (keep it below the browser's 120 s abort). Defaults: 90000 and 110000.
AI_PROVIDER_TIMEOUT_MS=
AI_TOTAL_TIMEOUT_MS=
#
# Groq — text models only: Groq has no image models, so it is skipped for sign generation and is
# ready for future text features.
GROQ_API_KEY=
GROQ_MODEL=
#
# Google Gemini — image editing (Nano Banana family). Image output may require billing; treat the
# free tier as a bonus, never as a guarantee, and change GEMINI_MODEL when Google retires a model.
GEMINI_API_KEY=
GEMINI_MODEL=
#
# OpenRouter — image editing through chat completions. OPENROUTER_MODEL must name a model that
# accepts image input and returns image output (see openrouter.ai/models?input_modalities=image).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
#
# Pollinations — image editing via POST https://gen.pollinations.ai/v1/images/edits (multipart
# upload of the storefront photo). OPT-IN: nothing is sent to Pollinations unless you add it to
# AI_PROVIDER_ORDER below (e.g. AI_PROVIDER_ORDER=pollinations,gemini,openrouter) or pin it with
# AI_PROVIDER=pollinations. It is skipped with no request when POLLINATIONS_API_KEY is empty.
# The key is a backend-only Pollinations secret key (sk_...); never expose it to a browser.
# POLLINATIONS_MODEL must accept image input: the endpoint's own default is a text-to-image model
# that would ignore the photo, so an edit-capable model is sent explicitly.
# Pollinations documents a Pollen balance/credit system, not a free daily quota. Do not assume any
# free allowance: check your balance in the Pollinations dashboard.
POLLINATIONS_API_KEY=
POLLINATIONS_MODEL=
#
# Legacy single-provider pin, still honored: setting AI_PROVIDER=cloudflare-flux keeps Workers AI
# with FLUX.2 Klein 9B first in the chain, with every configured provider above as a fallback.
# AI_PROVIDER=demo (or empty) means "no pin"; only configured keys are called. An unknown name is
# reported honestly and never fabricates an image.
AI_PROVIDER=demo
# Reserved for future adapters; unused today.
AI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
QUOTE_STORAGE_PROVIDER=demo
QUOTE_STORAGE_URL=
QUOTE_STORAGE_KEY=

# --- Authentication (server-side only; never prefix these with VITE_) -------------------------
# There is no user database: accounts come from the deployment environment. Passwords are stored
# only as PBKDF2-SHA256 hashes; plaintext is refused by the server.
#
# Signing key for the session cookie (HMAC-SHA256). At least 32 random characters, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SESSION_SECRET=
# Session lifetime in minutes. Default 720 (12 hours).
AUTH_SESSION_TTL_MINUTES=
# Cookie name (default signcraft_session) and SameSite mode: lax (default) | strict | none.
# Use `none` only if the app is embedded in a frame on another site (it then requires HTTPS).
AUTH_COOKIE_NAME=
AUTH_COOKIE_SAME_SITE=
#
# The owner account — the ONLY way an ADMIN can exist. ADMIN entries in AUTH_USERS_JSON are refused.
# Create the hash without ever printing the password:
#   npm run hash-password
AUTH_OWNER_USERNAME=
AUTH_OWNER_EMAIL=
AUTH_OWNER_PASSWORD_HASH=
#
# Optional additional accounts, PRO or CUSTOMER only, as a JSON array:
# AUTH_USERS_JSON=[{"id":"pro-1","username":"atelier","email":"atelier@example.com","role":"PRO","passwordHash":"pbkdf2-sha256$210000$..."}]
AUTH_USERS_JSON=
